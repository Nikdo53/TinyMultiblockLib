{
    "schemaVersion": 1,
    "id": "tinymultiblocklib",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/Nikdo53/TinyMultiblockLib",
        "issues": "https://github.com/Nikdo53/TinyMultiblockLib/issues"
    },
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
          "net.nikdo53.tinymultiblocklib.TinyMultiblockLibFabric"
        ],
        "client": [
        "net.nikdo53.tinymultiblocklib.TinyMultiBlockLibClient"
        ]
    },
    "mixins": [
        "tinymultiblocklib.fabric.mixins.json",
        "tinymultiblocklib.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.14",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=17"
    },
    "suggests": {
        "another-mod": "*"
    },

    "icon": "icon.png",

    "custom": {
        "modmenu": {
            "badges": [],
            "id": "${mod_id}",
            "name": "${mod_name}",
            "description": "${description}",
            "icon": "icon.png"
        }
    }
}
  